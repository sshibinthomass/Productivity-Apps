rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sites/{siteId} {
      allow get, list: if signedInAs(userId);
      allow update: if false;
      allow create, delete: if false;

      match /analytics/{documentId} {
        allow get, list: if signedInAs(userId);
        allow write: if false;
      }

      match /analyticsDays/{documentId} {
        allow get, list: if signedInAs(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/private/{documentId} {
      allow get: if signedInAs(userId);
      allow list, write: if false;
    }

    match /publishedMiniSites/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    match /miniSiteSlugs/{slug} {
      allow read, write: if false;
    }

    match /miniSiteEventReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
