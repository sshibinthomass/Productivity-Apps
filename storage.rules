rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validImageUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /mini-site-drafts/{userId}/{siteId}/{assetId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validImageUpload();
      allow delete: if signedInAs(userId);
    }

    match /mini-site-public/{siteId}/{revision}/{assetId} {
      allow read: if true;
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
